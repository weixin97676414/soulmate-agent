body{margin:0;padding:24px 18px;background:#fff;color:#222;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;line-height:1.85;font-size:16px;letter-spacing:.01em}
h1{font-size:30px;line-height:1.35;margin:0 0 22px;font-weight:700}
h2{font-size:23px;line-height:1.45;margin:34px 0 14px;font-weight:700;border-left:4px solid #222;padding-left:10px}
h3{font-size:19px;line-height:1.5;margin:26px 0 10px}
p{margin:0 0 16px}
blockquote{margin:20px 0;padding:14px 16px;background:#f7f7f7;border-left:4px solid #999;color:#444}
.callout{margin:20px 0;padding:16px;background:#f5f7fa;border-radius:10px}
table{width:100%;border-collapse:collapse;margin:18px 0;font-size:14px}
th,td{border:1px solid #ddd;padding:8px;text-align:left}
img{max-width:100%;height:auto;display:block;margin:18px auto}
