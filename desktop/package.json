{
  "name": "soulmate-desktop",
  "productName": "Soulmate Agent",
  "version": "0.0.1",
  "private": true,
  "description": "自研智能体框架的 Windows 桌面客户端",
  "author": "Soulmate Team",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run make-cursors && concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "make-cursors": "node scripts/make-cursors.mjs",
    "build:renderer": "vite build",
    "build:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "build": "npm run make-cursors && npm run build:renderer && npm run build:electron",
    "build:core": "node scripts/build-core.mjs",
    "publish:local": "node scripts/publish-local.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "node scripts/dist.mjs",
    "reset:local": "node ../scripts/reset-local-data.mjs",
    "clean:residue": "node ../scripts/clean-test-residue.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.46.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.soulmate.app",
    "productName": "Soulmate Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core/dist/agent-core",
        "to": "agent-core"
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Soulmate Agent",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
